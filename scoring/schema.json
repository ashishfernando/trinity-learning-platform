{
  "type": "object",
  "required": ["summary", "criteria", "moments", "confidence", "flags"],
  "properties": {
    "summary": {"type": "string"},
    "criteria": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "score", "evidence", "feedback"],
      "properties": {
        "id": {"type": "string"},
        "score": {"type": "integer", "minimum": 0, "maximum": 100},
        "evidence": {"type": "array", "items": {"type": "object", "required": ["t", "quote"],
          "properties": {"t": {"type": "string"}, "quote": {"type": "string"}}}},
        "feedback": {"type": "string"}}}},
    "moments": {"type": "array", "maxItems": 4, "items": {
      "type": "object", "required": ["kind", "t", "quote", "why"],
      "properties": {"kind": {"enum": ["strong", "improve"]}, "t": {"type": "string"}, "quote": {"type": "string"}, "why": {"type": "string"}}}},
    "values": {"type": "array", "items": {"type": "object", "required": ["name", "level"],
      "properties": {"name": {"type": "string"}, "level": {"enum": ["strong", "developing", "not_shown"]}, "quote": {"type": "string"}}}},
    "confidence": {"enum": ["high", "medium", "low"]},
    "flags": {"type": "array", "items": {"type": "string"}}
  }
}
